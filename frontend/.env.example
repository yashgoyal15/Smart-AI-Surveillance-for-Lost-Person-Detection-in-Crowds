# copy this file to .env before running the project

# Flask backend (NO "/api" at the end - the code adds it)
VITE_API_BASE_URL=http://localhost:5000

# AI service that streams the live camera video
VITE_AI_SERVICE_URL=http://localhost:5001

# how often dashboard / alerts refresh, in milliseconds
VITE_ALERT_POLL_INTERVAL=5000

# copy this file to .env before running

# ---- database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lost_person_db

# ---- security ----
# must be a long random string (32+ characters). The AI service uses the SAME value
# so it can verify the login token when the browser asks for a live camera stream.
JWT_SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
# shared secret between backend <-> AI service (they call each other with it)
INTERNAL_API_KEY=change-this-internal-key
# people can only sign up as "operator" if they know this code (reporters sign up freely)
OPERATOR_SIGNUP_CODE=ABES-OPERATOR-2026

# ---- AI service ----
AI_SERVICE_URL=http://localhost:5001

# ---- face matching ----
# cosine similarity needed to call two faces the same person (0 to 1).
# ArcFace gives ~0.5+ for the same person, so 0.85 (from the ppt) is far too strict.
MATCH_THRESHOLD=0.5

FRONTEND_ORIGIN=http://localhost:5173
FLASK_PORT=5000

# ---- v2 settings ----
# same person + same camera is not logged again within this many seconds (kept in the database)
ALERT_COOLDOWN_SECONDS=15
# clothes-only ("possible") alerts are weaker evidence, so they repeat less often
POSSIBLE_COOLDOWN_SECONDS=60
# how many cameras the Camera Feeds page lets you add
MAX_CAMERAS=8
MAX_PHOTOS_PER_PERSON=5

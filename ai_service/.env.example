# copy this file to .env before running

# same database the backend uses
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lost_person_db

# where the Flask backend is running (the AI service posts alerts there)
BACKEND_URL=http://localhost:5000

# these two MUST be identical to the values in backend/.env
INTERNAL_API_KEY=change-this-internal-key
JWT_SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars

# cosine similarity needed for a MATCH (same value as backend/.env)
MATCH_THRESHOLD=0.5

# YOLOv8 weights: "yolov8n.pt" downloads automatically the first time (nano = fastest on CPU)
YOLO_MODEL=yolov8n.pt
# ArcFace (insightface buffalo_l) downloads automatically to ~/.insightface the first time.
# INSIGHTFACE_ROOT=

# how many seconds between AI runs on one camera (0.5 = about 2 checks per second)
PROCESS_INTERVAL=0.5
# do not raise the same alert for the same person on the same camera more often than this
ALERT_COOLDOWN_SECONDS=15
# start all 4 cameras automatically when the AI service boots
AUTO_START_CAMERAS=false
PORT=5001

# ---- speed knobs (raise speed on a slow computer by lowering these) ----
# frames wider than this are shrunk before the AI looks at them
MAX_FRAME_WIDTH=960
# only the biggest N people in a frame are checked
MAX_PEOPLE_PER_FRAME=8
